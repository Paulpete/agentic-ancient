# ─── Reown AppKit (Wallet Integration) ───────────────────────────────────────
# Get your free project ID at https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=your_project_id_here

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://localhost:3000

# ─── Solana RPC ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
HELIUS_API_KEY=your_helius_api_key_here

# ─── Agent Wallet (Ralph / CryptoGene) ───────────────────────────────────────
# The Solana wallet address Ralph executes strategies from.
# Tax events are attributed to this address.
AGENT_WALLET_ADDRESS=your_solana_wallet_address_here

# ─── Biconomy (Gasless EVM transactions) ─────────────────────────────────────
# Get your API key at https://dashboard.biconomy.io
# Steps:
#   1. Create account at dashboard.biconomy.io
#   2. Add new Smart Account → select Base mainnet (chainId 8453) or Base Goerli for testing
#   3. Enable Sponsored Paymaster → deposit ETH (even 0.01 ETH covers many txs)
#   4. Copy the Paymaster API key below
#   5. The bundler URL is auto-configured per chain in lib/ethereum/biconomy.ts
NEXT_PUBLIC_BICONOMY_API_KEY=your_biconomy_paymaster_api_key_here
BICONOMY_API_KEY=your_biconomy_paymaster_api_key_here   # Same key — server-side

# ETH private key for the server-side Smart Account signer (Ralph's EVM wallet)
# NEVER use your main wallet. Generate a fresh one:
#   node -e "const {ethers}=require('ethers'); const w=ethers.Wallet.createRandom(); console.log('pk:', w.privateKey, '\naddr:', w.address)"
# Fund it with a tiny amount of ETH on Base for initial Smart Account deployment (~$0.01)
ETH_PRIVATE_KEY=0x_your_fresh_eth_private_key_here

# ─── Telegram Bot (Ralph notifications) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/empire_matrix

# ─── Moralis ─────────────────────────────────────────────────────────────────
MORALIS_API_KEY=your_moralis_api_key

# ─── Price Oracle (for solana-tax engine) ────────────────────────────────────
# Optional — CoinGecko free tier used by default (no key needed)
# BIRDEYE_API_KEY=your_birdeye_api_key   # Enables better Solana price data
