# ─── Solana ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
AGENT_WALLET_ADDRESS=your_solana_wallet_address_here

# ─── Biconomy ─────────────────────────────────────────────────────────────────
BICONOMY_API_KEY=your_biconomy_paymaster_api_key
BICONOMY_BUNDLER_KEY=your_biconomy_bundler_api_key
# ^ FIX: was hardcoded as nJPK7B32G.7f948574-... in source — moved to env

# ─── EVM / Ethereum ──────────────────────────────────────────────────────────
ETH_PRIVATE_KEY=your_server_side_private_key_hex
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
ETH_RPC_URL=https://eth.llamarpc.com

# ─── Reown / WalletConnect ───────────────────────────────────────────────────
NEXT_PUBLIC_REOWN_PROJECT_ID=get_from_cloud.reown.com

# ─── Frontend tx recipient ───────────────────────────────────────────────────
# FIX: was hardcoded 0x322Af0da66D00be980C7aa006377FCaaEee34252 in page.tsx
NEXT_PUBLIC_TX_RECIPIENT=0xYourTransactionRecipientAddress

# ─── API Auth ─────────────────────────────────────────────────────────────────
# Protects /api/ralph (start/stop loop) and /api/biconomy/relay (drain risk)
# Leave empty to disable auth in dev. REQUIRED in production.
RALPH_API_KEY=generate_a_secure_random_string
RELAY_API_KEY=generate_a_secure_random_string

# ─── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
BIRDEYE_API_KEY=optional_for_enhanced_historical_pricing
